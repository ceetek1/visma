@model HomeIndexViewModel
@inject TimeProvider Clock
@{
    ViewData["Title"] = "Dashboard";
    var onSite = Model.OnSite.Count;
    var stats = Model.Stats;
    var compact = onSite > 4; // more than a handful of passes reads better as a table
    var nowUtc = Clock.GetUtcNow().UtcDateTime;
}

<section class="welcome dash-welcome">
    <div class="welcome-text">
        <p class="welcome-date">@Model.LocalNow.ToString("dddd d MMMM yyyy")</p>
        <h2 class="welcome-greeting">@Model.Greeting.</h2>
        <p class="welcome-lede">
            @if (onSite == 0)
            {
                <text>Nobody is signed in at the front desk right now.</text>
            }
            else
            {
                <text><strong>@onSite @(onSite == 1 ? "person is" : "people are")</strong> on site right now.</text>
            }
        </p>
    </div>

    <ul class="dash-facts" aria-label="Today at the front desk">
        <li><span class="dash-fact-num">@stats.OnSiteNow</span> on site now</li>
        <li><span class="dash-fact-num">@stats.CheckInsToday</span> checked in today</li>
        <li><span class="dash-fact-num">@stats.CheckedOutToday</span> of them checked out</li>
        <li><span class="dash-fact-num">@stats.TotalVisitors</span> visitors registered</li>
    </ul>
</section>

<section class="on-site" aria-labelledby="onSiteHeading">
    <header class="on-site-head">
        <h2 id="onSiteHeading" class="panel-title">On site now</h2>
        <a asp-controller="Visits" asp-action="History">Visit log</a>
    </header>

    @if (onSite == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("bi-door-open", "The building is empty",
                 "When someone checks in, their visitor pass appears here.",
                 "Check in a visitor", Url.Action("CheckIn", "Visits"))' />
    }
    else if (!compact)
    {
        <div class="pass-grid">
            @foreach (var visit in Model.OnSite)
            {
                <div class="pass-card">
                    <partial name="_VisitorPass" model="visit" />
                    <form asp-controller="Visits" asp-action="CheckOut" asp-route-id="@visit.Id" method="post">
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="btn btn-outline-secondary w-100 justify-content-center"
                                aria-label="Check out @visit.Visitor?.FullName">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            Check out
                        </button>
                    </form>
                </div>
            }
        </div>
    }
    else
    {
        <div class="panel">
            <div class="table-responsive">
                <table class="table table-hover table-stack">
                    <thead>
                        <tr>
                            <th scope="col">Visitor</th>
                            <th scope="col">Seeing</th>
                            <th scope="col" class="col-purpose-xl">Purpose</th>
                            <th scope="col">Arrived</th>
                            <th scope="col"><span class="visually-hidden">Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visit in Model.OnSite)
                        {
                            <tr>
                                <td class="cell-wide">
                                    <a asp-controller="Visits" asp-action="Pass" asp-route-id="@visit.Id" class="fw-bold">@visit.Visitor?.FullName</a>
                                    <span class="cell-sub">@visit.Visitor?.Company</span>
                                </td>
                                <td data-label="Seeing">@visit.Host?.FullName <span class="cell-sub">@visit.Host?.Department</span></td>
                                <td class="col-purpose-xl" data-label="Purpose">@visit.Purpose.GetDisplayName()</td>
                                <td class="text-nowrap" data-label="Arrived">
                                    @visit.CheckInTime.ToDisplayTime()
                                    <span class="cell-sub">@visit.Duration(nowUtc).ToFriendlyDuration() so far</span>
                                </td>
                                <td class="text-end cell-wide">
                                    <form asp-controller="Visits" asp-action="CheckOut" asp-route-id="@visit.Id" method="post">
                                        <input type="hidden" name="returnUrl" value="/" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                aria-label="Check out @visit.Visitor?.FullName">Check out</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<section class="panel increments" aria-labelledby="incrementsHeading">
    <header class="panel-head">
        <h2 id="incrementsHeading" class="panel-title">Project increments</h2>
        <p class="panel-sub">VISMA is built in three increments. Each one switches on in the menu when its code is merged.</p>
    </header>
    <ol class="increment-list">
        @foreach (var inc in Model.Increments)
        {
            <li class="increment @(inc.IsReady ? "is-ready" : "is-waiting")">
                <span class="increment-marker" aria-hidden="true">
                    <i class="bi @(inc.IsReady ? "bi-check-lg" : "bi-hourglass-split")"></i>
                </span>
                <div>
                    <p class="increment-name">@inc.Name <span class="increment-owner">@inc.Owner</span></p>
                    <p class="increment-summary">@inc.Summary</p>
                </div>
                <span class="increment-state">@(inc.IsReady ? "Ready" : "In progress")</span>
            </li>
        }
    </ol>
</section>
