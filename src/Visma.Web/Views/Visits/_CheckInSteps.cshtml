@model int
@*
    Where the receptionist is in the three-step check-in. Model = current step (1–3).
    <partial name="_CheckInSteps" model="1" />
*@
@{
    var steps = new[] { "Find the visitor", "Host and purpose", "Visitor pass" };
}
<ol class="checkin-steps" aria-label="Check-in progress">
    @for (var i = 0; i < steps.Length; i++)
    {
        var n = i + 1;
        var state = n < Model ? "is-done" : n == Model ? "is-current" : "";
        <li class="checkin-step @state" aria-current="@(n == Model ? "step" : null)">
            <span class="checkin-step-no" aria-hidden="true">
                @if (n < Model)
                {
                    <i class="bi bi-check-lg"></i>
                }
                else
                {
                    @n
                }
            </span>
            <span>@steps[i]</span>
        </li>
    }
</ol>
