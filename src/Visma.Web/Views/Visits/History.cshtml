@model VisitHistoryViewModel
@inject NavigationHelper Nav
@inject TimeProvider Clock
@{
    ViewData["Title"] = "Visit log";
    var linkVisitors = Nav.Exists("Visitors", "Details");
    var nowUtc = Clock.GetUtcNow().UtcDateTime;
    var count = Model.Visits.Count;
    string Day(DateOnly d) => d.ToString("d MMM yyyy");
}

<section class="panel history-filters" aria-label="Filter visits">
    <form method="get" asp-action="History" class="history-form">
        <div>
            <label for="from" class="form-label">From</label>
            <input id="from" name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="to" class="form-label">To</label>
            <input id="to" name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        <div class="history-host">
            <label for="hostId" class="form-label">Host</label>
            <select id="hostId" name="hostId" class="form-select" asp-items="Model.Hosts">
                <option value="">Everyone</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel" aria-hidden="true"></i>
            Show visits
        </button>
    </form>
</section>

<section class="panel" aria-labelledby="logHeading">
    @if (Model.FilterError is not null)
    {
        <div class="flash flash-error mb-0" role="alert">
            <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
            <span id="logHeading">@Model.FilterError</span>
        </div>
    }
    else if (count == 0)
    {
        <h2 id="logHeading" class="visually-hidden">Visits</h2>
        <partial name="_EmptyState" model='new EmptyStateModel("bi-journal-x", "No visits in this period",
                 $"Nobody checked in between {Day(Model.From)} and {Day(Model.To)}. Try a wider date range or another host.")' />
    }
    else
    {
        <header class="panel-head">
            <h2 id="logHeading" class="panel-title">
                @count @(count == 1 ? "visit" : "visits") between @Day(Model.From) and @Day(Model.To)
            </h2>
        </header>
        <div class="table-responsive">
            <table class="table table-hover table-stack history-table">
                <thead>
                    <tr>
                        <th scope="col">Visitor</th>
                        <th scope="col">Host</th>
                        <th scope="col" class="col-purpose">Purpose</th>
                        <th scope="col">Checked in</th>
                        <th scope="col" class="col-out">Checked out</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var visit in Model.Visits)
                    {
                        <tr>
                            <td class="cell-wide">
                                @if (linkVisitors)
                                {
                                    <a asp-controller="Visitors" asp-action="Details" asp-route-id="@visit.VisitorId" class="fw-bold">@visit.Visitor?.FullName</a>
                                }
                                else
                                {
                                    <span class="fw-bold">@visit.Visitor?.FullName</span>
                                }
                                <span class="cell-sub">@visit.Visitor?.Phone</span>
                            </td>
                            <td data-label="Host">
                                @visit.Host?.FullName
                                <span class="cell-sub">@visit.Host?.Department@(visit.Host is { IsActive: false } ? " (no longer here)" : "")</span>
                            </td>
                            <td class="col-purpose" data-label="Purpose">
                                @visit.Purpose.GetDisplayName()
                                @if (!string.IsNullOrWhiteSpace(visit.Notes))
                                {
                                    <span class="cell-sub">@visit.Notes</span>
                                }
                            </td>
                            <td class="text-nowrap" data-label="Checked in">@visit.CheckInTime.ToDisplayTime()</td>
                            <td class="text-nowrap col-out" data-label="Checked out">@visit.CheckOutTime.ToDisplayTime()</td>
                            <td class="text-nowrap" data-label="Duration">@visit.Duration(nowUtc).ToFriendlyDuration()</td>
                            <td data-label="Status"><partial name="_StatusBadge" model="visit.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
