<Project Sdk="Microsoft.NET.Sdk">

  <!-- DATA ACCESS LAYER: EF Core + SQLite persistence. Implements the repository
       interfaces declared in Visma.Core. Nothing in here knows about the web UI. -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Visma.Core\Visma.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
  </ItemGroup>

</Project>
